# From @BotFather
TELEGRAM_BOT_TOKEN=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Neon / any Postgres connection string
DATABASE_URL=
# Vercel AI Gateway key (not needed on Vercel when OIDC is available)
AI_GATEWAY_API_KEY=
# Optional override of the moderation model
MODERATION_MODEL=anthropic/claude-haiku-5.5
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes
CRON_SECRET=
